+  test("escaped asterisk replaces only the literal asterisk, not repeated neighbors", async () => {
+    const file = join(tmpProj, "star.txt");
+    // An unescaped `*` would be a quantifier (invalid at pattern start);
+    // `a\*` must match only "a*". "aaa" and "a" stay byte-identical, which
+    // proves the star was literal and not "zero or more a".
+    const original = "a* aaa a 2*3 café*\n";
+    const expected = "a+ aaa a 2+3 café+\n";
+    await writeFile(file, original);
+
+    const args = { pattern: "\\*", replacement: "+" };
+    const dryRun = await ashlrSearchReplaceRegex({ ...args, dryRun: true });
+    expect(dryRun.text).toContain("1 file, 3 replacements");
+    expect(await readFile(file)).toEqual(Buffer.from(original, "utf-8"));
+
+    const result = await ashlrSearchReplaceRegex(args);
+    expect(result.text).toContain("1 file, 3 replacements");
+    expect(await readFile(file)).toEqual(Buffer.from(expected, "utf-8"));
+  });
