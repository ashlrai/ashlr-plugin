+    // "aa" matches non-overlapping left to right: six `a`s are three
+    // back-to-back matches, and "aaa" leaves a single trailing "a" the
+    // scan must not consume.
+    const { updated, count, capped } = applyRegex("aaaaaa aaa", /aa/g, "N", 100);
