diff --git a/scripts/_benchmark-v2-schema.ts b/scripts/_benchmark-v2-schema.ts
new file mode 100644
--- /dev/null
+++ b/scripts/_benchmark-v2-schema.ts
@@ -0,0 +1,301 @@
+/**
+ * scripts/_benchmark-v2-schema.ts
+ *
+ * Dependency-free schema validator for docs/benchmarks-v2.json (and the
+ * site/public copy the site serves). The shape is the union of what
+ * scripts/run-benchmark.ts writes (version/measuredAt/repo/samples/aggregate/
+ * methodology, optional heuristicError) and what scripts/benchmark-refs.ts
+ * merges in (byRepo/byLanguage/crossLanguage fields and crossLanguageMeasuredAt), plus
+ * the optional caveat note.
+ *
+ * The original schema tests pin the published snapshots and prove malformed
+ * data is rejected. Current main also has a separate benchmark-schema.ts
+ * validator.
+ *
+ * Validation returns a list of human-readable errors; an empty list means the
+ * document conforms.
+ */
+
+const SIZE_BUCKETS = ["2-5KB", "5-15KB", "15-50KB", "50+KB"] as const;
+const EDIT_SIZES = ["small", "medium", "large"] as const;
+const GREP_METHODS = ["rg-truncated"] as const;
+const TOOLS = ["ashlr__read", "ashlr__grep", "ashlr__edit"] as const;
+const PER_TOOL_KEYS = ["read", "grep", "edit"] as const;
+const SECTION_KEYS = [
+  "byRepo",
+  "byLanguage",
+  "crossLanguageMean",
+  "crossLanguageSavingsPct",
+  "crossLanguageMeasuredAt",
+] as const;
+
+type ObjectValue = Record<string, unknown>;
+
+function isObject(value: unknown): value is ObjectValue {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function checkNonEmptyString(record: ObjectValue, key: string, path: string, errors: string[]): void {
+  const value = record[key];
+  if (typeof value !== "string" || value.trim().length === 0) {
+    errors.push(`${path}.${key}: expected a nonempty string`);
+  }
+}
+
+function checkFiniteNumber(
+  record: ObjectValue,
+  key: string,
+  path: string,
+  errors: string[],
+  { min = 0 }: { min?: number } = {},
+): void {
+  const value = record[key];
+  if (typeof value !== "number" || !Number.isFinite(value)) {
+    errors.push(`${path}.${key}: expected a finite number`);
+  } else if (value < min) {
+    errors.push(`${path}.${key}: expected a number >= ${min}`);
+  }
+}
+
+function checkTimestamp(record: ObjectValue, key: string, path: string, errors: string[]): void {
+  const value = record[key];
+  if (typeof value !== "string" || Number.isNaN(Date.parse(value))) {
+    errors.push(`${path}.${key}: expected a parseable timestamp string`);
+  }
+}
+
+function checkEnum(
+  record: ObjectValue,
+  key: string,
+  path: string,
+  allowed: readonly string[],
+  errors: string[],
+): void {
+  const value = record[key];
+  if (typeof value !== "string" || !allowed.includes(value)) {
+    errors.push(`${path}.${key}: expected one of ${allowed.map((a) => JSON.stringify(a)).join(", ")}`);
+  }
+}
+
+function checkToolAggregate(value: unknown, path: string, errors: string[]): void {
+  if (!isObject(value)) {
+    errors.push(`${path}: expected an object`);
+    return;
+  }
+  checkFiniteNumber(value, "mean", path, errors);
+  checkFiniteNumber(value, "p50", path, errors);
+  checkFiniteNumber(value, "p90", path, errors);
+  const ci = value.confidenceInterval;
+  if (!isObject(ci)) {
+    errors.push(`${path}.confidenceInterval: expected an object`);
+    return;
+  }
+  checkFiniteNumber(ci, "lo", `${path}.confidenceInterval`, errors);
+  checkFiniteNumber(ci, "hi", `${path}.confidenceInterval`, errors);
+  if (
+    typeof ci.lo === "number" &&
+    typeof ci.hi === "number" &&
+    Number.isFinite(ci.lo) &&
+    Number.isFinite(ci.hi) &&
+    ci.lo > ci.hi
+  ) {
+    errors.push(`${path}.confidenceInterval: lo must be <= hi`);
+  }
+}
+
+function checkReadSample(sample: ObjectValue, path: string, errors: string[]): void {
+  checkNonEmptyString(sample, "path", path, errors);
+  checkEnum(sample, "bucket", path, SIZE_BUCKETS, errors);
+  for (const key of ["rawBytes", "rawTokens", "ashlrBytes", "ashlrTokens", "ratio"]) {
+    checkFiniteNumber(sample, key, path, errors);
+  }
+}
+
+function checkGrepSample(sample: ObjectValue, path: string, errors: string[]): void {
+  checkNonEmptyString(sample, "pattern", path, errors);
+  checkEnum(sample, "method", path, GREP_METHODS, errors);
+  for (const key of ["rawBytes", "rawTokens", "ashlrBytes", "ashlrTokens", "ratio"]) {
+    checkFiniteNumber(sample, key, path, errors);
+  }
+}
+
+function checkEditSample(sample: ObjectValue, path: string, errors: string[]): void {
+  checkEnum(sample, "size", path, EDIT_SIZES, errors);
+  for (const key of [
+    "searchChars",
+    "replaceChars",
+    "naiveBytes",
+    "naiveTokens",
+    "ashlrBytes",
+    "ashlrTokens",
+    "ratio",
+  ]) {
+    checkFiniteNumber(sample, key, path, errors);
+  }
+}
+
+const SAMPLE_CHECKS: Record<(typeof TOOLS)[number], (s: ObjectValue, p: string, e: string[]) => void> = {
+  ashlr__read: checkReadSample,
+  ashlr__grep: checkGrepSample,
+  ashlr__edit: checkEditSample,
+};
+
+/**
+ * Any record anywhere in the document that carries a `pattern` key must carry
+ * a nonempty string — a blank pattern means a benchmark entry that cannot be
+ * reproduced or audited.
+ */
+function checkPatterns(value: unknown, path: string, errors: string[]): void {
+  if (Array.isArray(value)) {
+    for (let i = 0; i < value.length; i++) checkPatterns(value[i], `${path}[${i}]`, errors);
+    return;
+  }
+  if (!isObject(value)) return;
+  if ("pattern" in value) checkNonEmptyString(value, "pattern", path || "$", errors);
+  for (const key of Object.keys(value)) {
+    checkPatterns(value[key], path ? `${path}.${key}` : key, errors);
+  }
+}
+
+/**
+ * Validate the multi-repo sections merged in by scripts/benchmark-refs.ts.
+ * All five section keys are required here; the full-document validator only
+ * applies this when any of them is present (a plain run-benchmark output has
+ * none).
+ */
+export function validateBenchmarkV2Sections(record: unknown): string[] {
+  const errors: string[] = [];
+  if (!isObject(record)) return ["$: expected an object"];
+
+  checkTimestamp(record, "crossLanguageMeasuredAt", "$", errors);
+  checkFiniteNumber(record, "crossLanguageMean", "$", errors);
+  checkFiniteNumber(record, "crossLanguageSavingsPct", "$", errors);
+
+  const byLanguage = record.byLanguage;
+  if (!isObject(byLanguage)) {
+    errors.push("$.byLanguage: expected an object");
+  } else {
+    for (const key of Object.keys(byLanguage)) {
+      const entry = byLanguage[key];
+      const path = `$.byLanguage.${key}`;
+      if (!isObject(entry)) {
+        errors.push(`${path}: expected an object`);
+        continue;
+      }
+      checkNonEmptyString(entry, "language", path, errors);
+      checkFiniteNumber(entry, "meanRatio", path, errors);
+      checkFiniteNumber(entry, "savingsPct", path, errors);
+    }
+  }
+
+  const byRepo = record.byRepo;
+  if (!isObject(byRepo)) {
+    errors.push("$.byRepo: expected an object");
+  } else {
+    for (const key of Object.keys(byRepo)) {
+      const entry = byRepo[key];
+      const path = `$.byRepo.${key}`;
+      if (!isObject(entry)) {
+        errors.push(`${path}: expected an object`);
+        continue;
+      }
+      for (const field of ["repoKey", "language", "upstreamRepo", "refrev"]) {
+        checkNonEmptyString(entry, field, path, errors);
+      }
+      checkFiniteNumber(entry, "meanRatio", path, errors);
+      checkFiniteNumber(entry, "savingsPct", path, errors);
+      const perTool = entry.perTool;
+      if (!isObject(perTool)) {
+        errors.push(`${path}.perTool: expected an object`);
+        continue;
+      }
+      for (const tool of PER_TOOL_KEYS) {
+        const stats = perTool[tool];
+        const toolPath = `${path}.perTool.${tool}`;
+        if (!isObject(stats)) {
+          errors.push(`${toolPath}: expected an object`);
+          continue;
+        }
+        checkFiniteNumber(stats, "mean", toolPath, errors);
+        checkFiniteNumber(stats, "p50", toolPath, errors);
+        checkFiniteNumber(stats, "p90", toolPath, errors);
+      }
+    }
+  }
+
+  return errors;
+}
+
+/**
+ * Validate a full benchmarks-v2 document. Returns a list of errors; empty
+ * means valid. Sample arrays may be empty (run-benchmark on an empty repo is
+ * a legitimate result); a document that fails any check is rejected.
+ */
+export function validateBenchmarkV2(data: unknown): string[] {
+  const errors: string[] = [];
+  if (!isObject(data)) return ["$: expected a top-level object"];
+
+  if (data.version !== 2) errors.push("$.version: expected 2");
+  checkTimestamp(data, "measuredAt", "$", errors);
+  checkNonEmptyString(data, "methodology", "$", errors);
+
+  const repo = data.repo;
+  if (!isObject(repo)) {
+    errors.push("$.repo: expected an object");
+  } else {
+    checkNonEmptyString(repo, "url", "$.repo", errors);
+    checkNonEmptyString(repo, "commit", "$.repo", errors);
+    checkFiniteNumber(repo, "files", "$.repo", errors);
+    checkFiniteNumber(repo, "loc", "$.repo", errors);
+  }
+
+  const samples = data.samples;
+  if (!isObject(samples)) {
+    errors.push("$.samples: expected an object");
+  } else {
+    for (const tool of TOOLS) {
+      const entries = samples[tool];
+      const path = `$.samples.${tool}`;
+      if (!Array.isArray(entries)) {
+        errors.push(`${path}: expected an array`);
+        continue;
+      }
+      for (let i = 0; i < entries.length; i++) {
+        const entry = entries[i];
+        const entryPath = `${path}[${i}]`;
+        if (!isObject(entry)) {
+          errors.push(`${entryPath}: expected an object`);
+          continue;
+        }
+        SAMPLE_CHECKS[tool](entry, entryPath, errors);
+      }
+    }
+  }
+
+  const aggregate = data.aggregate;
+  if (!isObject(aggregate)) {
+    errors.push("$.aggregate: expected an object");
+  } else {
+    for (const tool of TOOLS) {
+      checkToolAggregate(aggregate[tool], `$.aggregate.${tool}`, errors);
+    }
+    const overall = aggregate.overall;
+    if (!isObject(overall)) {
+      errors.push("$.aggregate.overall: expected an object");
+    } else {
+      checkFiniteNumber(overall, "mean", "$.aggregate.overall", errors);
+    }
+  }
+
+  // Optional fields emitted only in some flows.
+  if ("heuristicError" in data && data.heuristicError !== null) {
+    checkFiniteNumber(data, "heuristicError", "$", errors);
+  }
+  if ("caveat" in data) checkNonEmptyString(data, "caveat", "$", errors);
+  if (SECTION_KEYS.some((key) => key in data)) {
+    errors.push(...validateBenchmarkV2Sections(data));
+  }
+
+  checkPatterns(data, "", errors);
+  return errors;
+}
diff --git a/__tests__/benchmark-v2-schema-original-689.test.ts b/__tests__/benchmark-v2-schema-original-689.test.ts
new file mode 100644
--- /dev/null
+++ b/__tests__/benchmark-v2-schema-original-689.test.ts
@@ -0,0 +1,167 @@
+import { describe, expect, test } from "bun:test";
+import { readFileSync } from "node:fs";
+
+import { validateBenchmarkV2, validateBenchmarkV2Sections } from "../scripts/_benchmark-v2-schema";
+
+// docs/benchmarks-v2.json is canonical (written by scripts/run-benchmark.ts and
+// extended by scripts/benchmark-refs.ts); site/public/benchmarks-v2.json is the
+// copy the site serves. Both must satisfy the shared v2 schema.
+const files = ["docs/benchmarks-v2.json", "site/public/benchmarks-v2.json"];
+const tools = ["ashlr__read", "ashlr__grep", "ashlr__edit"] as const;
+
+type ObjectValue = Record<string, unknown>;
+
+const load = (file: string): unknown =>
+  JSON.parse(readFileSync(new URL(`../${file}`, import.meta.url), "utf8"));
+
+function* recordsWithPattern(value: unknown, path: string): Generator<{ path: string; record: ObjectValue }> {
+  if (Array.isArray(value)) {
+    for (let i = 0; i < value.length; i++) yield* recordsWithPattern(value[i], `${path}[${i}]`);
+  } else if (value !== null && typeof value === "object") {
+    const record = value as ObjectValue;
+    if ("pattern" in record) yield { path, record };
+    for (const key of Object.keys(record)) yield* recordsWithPattern(record[key], path ? `${path}.${key}` : key);
+  }
+}
+
+function clone(value: unknown): ObjectValue {
+  return JSON.parse(JSON.stringify(value)) as ObjectValue;
+}
+
+function minimalValidDocument(): ObjectValue {
+  const aggregate = { mean: 0.2, p50: 0.2, p90: 0.4, confidenceInterval: { lo: 0.1, hi: 0.3 } };
+  return {
+    version: 2,
+    measuredAt: "2026-10-19T17:23:26.418Z",
+    repo: { url: "https://example.com/repo.git", commit: "abc123", files: 10, loc: 1000 },
+    samples: {
+      ashlr__read: [
+        {
+          path: "/repo/src/a.ts",
+          bucket: "2-5KB",
+          rawBytes: 3000,
+          rawTokens: 750,
+          ashlrBytes: 1600,
+          ashlrTokens: 400,
+          ratio: 0.5,
+        },
+      ],
+      ashlr__grep: [
+        {
+          pattern: "TODO",
+          rawBytes: 5000,
+          rawTokens: 1250,
+          ashlrBytes: 3600,
+          ashlrTokens: 900,
+          ratio: 0.72,
+          method: "rg-truncated",
+        },
+      ],
+      ashlr__edit: [
+        {
+          size: "small",
+          searchChars: 15,
+          replaceChars: 15,
+          naiveBytes: 47,
+          naiveTokens: 12,
+          ashlrBytes: 47,
+          ashlrTokens: 12,
+          ratio: 1,
+        },
+      ],
+    },
+    aggregate: {
+      ashlr__read: aggregate,
+      ashlr__grep: aggregate,
+      ashlr__edit: aggregate,
+      overall: { mean: 0.2 },
+    },
+    methodology: "Measurement methodology (version 2): …",
+  };
+}
+
+describe.each(files)("%s schema", (file) => {
+  test("conforms to the benchmarks-v2 schema with zero errors", () => {
+    expect(validateBenchmarkV2(load(file))).toEqual([]);
+  });
+
+  test("every benchmark entry carrying a pattern field has a nonempty pattern", () => {
+    const found = [...recordsWithPattern(load(file), "")];
+    expect(found.length).toBeGreaterThan(0);
+    for (const { path, record } of found) {
+      expect(typeof record.pattern, path).toBe("string");
+      expect((record.pattern as string).trim().length, path).toBeGreaterThan(0);
+    }
+  });
+});
+
+describe("benchmarks-v2 schema malformed fixtures", () => {
+  const docs = load("docs/benchmarks-v2.json") as ObjectValue;
+
+  test.each<[string, (data: ObjectValue) => void, RegExp]>([
+    ["blank grep pattern", (d) => { (d.samples as ObjectValue).ashlr__grep = [{ ...(d.samples as { ashlr__grep: ObjectValue[] }).ashlr__grep[0]!, pattern: "" }]; }, /pattern/],
+    ["whitespace-only grep pattern", (d) => { (d.samples as { ashlr__grep: ObjectValue[] }).ashlr__grep[0]!.pattern = "   "; }, /pattern/],
+    ["non-string grep pattern", (d) => { (d.samples as { ashlr__grep: ObjectValue[] }).ashlr__grep[0]!.pattern = 42; }, /pattern/],
+    ["pattern blanked in a nested record", (d) => { (d.byRepo as ObjectValue)["node-sdk"] = { ...(d.byRepo as ObjectValue)["node-sdk"] as ObjectValue, pattern: "" }; }, /pattern/],
+    ["version bumped to 3", (d) => { d.version = 3; }, /version/],
+    ["version removed", (d) => { delete d.version; }, /version/],
+    ["unparseable measuredAt", (d) => { d.measuredAt = "not-a-date"; }, /measuredAt/],
+    ["negative repo.files", (d) => { (d.repo as ObjectValue).files = -1; }, /repo\.files/],
+    ["samples entry not an array", (d) => { (d.samples as ObjectValue).ashlr__read = "nope"; }, /ashlr__read/],
+    ["sample entry not an object", (d) => { (d.samples as { ashlr__read: unknown[] }).ashlr__read[0] = null; }, /ashlr__read\[0\]/],
+    ["read sample bad bucket", (d) => { (d.samples as { ashlr__read: ObjectValue[] }).ashlr__read[0]!.bucket = "1-2KB"; }, /bucket/],
+    ["read sample NaN ratio", (d) => { (d.samples as { ashlr__read: ObjectValue[] }).ashlr__read[0]!.ratio = Number.NaN; }, /ratio/],
+    ["edit sample unknown size", (d) => { (d.samples as { ashlr__edit: ObjectValue[] }).ashlr__edit[0]!.size = "huge"; }, /size/],
+    ["confidence interval inverted", (d) => { ((d.aggregate as ObjectValue).ashlr__grep as ObjectValue).confidenceInterval = { lo: 1, hi: 0 }; }, /confidenceInterval/],
+    ["missing aggregate tool", (d) => { delete (d.aggregate as ObjectValue).ashlr__edit; }, /aggregate\.ashlr__edit/],
+    ["byRepo entry missing refrev", (d) => { delete ((d.byRepo as ObjectValue)["node-sdk"] as ObjectValue).refrev; }, /refrev/],
+    ["byRepo perTool missing grep", (d) => { delete (((d.byRepo as ObjectValue)["node-sdk"] as ObjectValue).perTool as ObjectValue).grep; }, /perTool\.grep/],
+    ["byLanguage meanRatio non-numeric", (d) => { ((d.byLanguage as ObjectValue).ts as ObjectValue).meanRatio = "high"; }, /meanRatio/],
+    ["partial sections (byRepo only)", (d) => { d.byLanguage = (d.byRepo as ObjectValue)["node-sdk"]; for (const k of ["crossLanguageMean", "crossLanguageSavingsPct", "crossLanguageMeasuredAt"]) delete d[k]; }, /crossLanguage/],
+  ])("rejects malformed fixture: %s", (_name, mutate, matcher) => {
+    const data = clone(docs);
+    mutate(data);
+    const errors = validateBenchmarkV2(data);
+    expect(errors.length).toBeGreaterThan(0);
+    expect(errors.some((e) => matcher.test(e))).toBe(true);
+  });
+
+  test.each<[string, unknown]>([
+    ["null", null],
+    ["a string", "not json data"],
+    ["a number", 2],
+    ["an array", []],
+  ])("rejects non-object document: %s", (_name, data) => {
+    expect(validateBenchmarkV2(data).length).toBeGreaterThan(0);
+  });
+
+  test("accepts a minimal valid document with no optional sections", () => {
+    expect(validateBenchmarkV2(minimalValidDocument())).toEqual([]);
+  });
+
+  test("accepts empty sample arrays (empty-repo runs are legitimate)", () => {
+    const data = minimalValidDocument();
+    const samples = data.samples as ObjectValue;
+    for (const tool of tools) samples[tool] = [];
+    expect(validateBenchmarkV2(data)).toEqual([]);
+  });
+});
+
+describe("validateBenchmarkV2Sections", () => {
+  const docs = load("docs/benchmarks-v2.json") as ObjectValue;
+
+  test("accepts the published multi-repo sections", () => {
+    expect(validateBenchmarkV2Sections(docs)).toEqual([]);
+  });
+
+  test("rejects non-object input and missing keys", () => {
+    expect(validateBenchmarkV2Sections(null).length).toBeGreaterThan(0);
+    expect(validateBenchmarkV2Sections({}).length).toBeGreaterThan(0);
+  });
+
+  test("rejects a malformed per-tool stat block", () => {
+    const data = clone(docs);
+    (((data.byRepo as ObjectValue)["python-lib"] as ObjectValue).perTool as ObjectValue).read = { mean: "fast" };
+    expect(validateBenchmarkV2Sections(data).some((e) => e.includes("perTool.read"))).toBe(true);
+  });
+});
