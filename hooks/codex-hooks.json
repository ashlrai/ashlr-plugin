{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/sessionstart-lean-tools.ts\""
          },
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/sessionstart-efficient.ts\""
          },
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/sessionstart-genome-author.ts\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/userpromptsubmit-brief-trigger.ts\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|functions.exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/pretooluse-bash.ts\""
          }
        ]
      },
      {
        "matcher": "apply_patch|functions.apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/pretooluse-edit.ts\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/pretooluse-read.ts\""
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/pretooluse-grep.ts\""
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/pretooluse-glob.ts\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/pretooluse-write.ts\""
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/pretooluse-edit.ts\""
          }
        ]
      },
      {
        "matcher": "mcp__ashlr__ashlr__read|mcp__ashlr__ashlr__grep|mcp__ashlr__ashlr__tree|mcp__ashlr__ashlr__savings",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/pretooluse-budget-guard.ts\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|exec_command|functions.exec_command|apply_patch|functions.apply_patch|Read|Grep|Glob|Write|Edit|MultiEdit|mcp__ashlr__ashlr__read|mcp__ashlr__ashlr__grep|mcp__ashlr__ashlr__edit|mcp__ashlr__ashlr__multi_edit|mcp__ashlr__ashlr__write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/post-tool-use-genome.ts\""
          },
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/session-log-append.ts\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/session-end-consolidate.ts\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/sessionstart-lean-tools.ts\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/sessionstart-efficient.ts\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/subagent-stop-rollup.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/hook-bootstrap.mjs\" \"${CODEX_PLUGIN_ROOT}/hooks/stop-accounting.ts\""
          }
        ]
      }
    ]
  }
}
