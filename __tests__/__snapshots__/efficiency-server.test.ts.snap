exports[`MCP server · bootstrap tools/list returns all registered tools with schemas 1`] = `
{
  "tools": [
    {
      "description": "Read a file with automatic snipCompact truncation for results > 2KB. Preserves head + tail, elides middle. Lower-token alternative to the built-in Read tool.",
      "inputSchema": {
        "properties": {
          "bypassSummary": {
            "description": "Skip LLM summarization, return snipCompact-truncated content (default: false)",
            "type": "boolean",
          },
          "path": {
            "description": "Absolute or cwd-relative file path",
            "type": "string",
          },
